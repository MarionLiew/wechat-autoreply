# ── 大模型配置 ──────────────────────────────────────────────
# provider 可选：anthropic / openai / moonshot / zhipu / qwen / mimo / custom
LLM_PROVIDER=anthropic

# API Key（anthropic 填 sk-ant-xxx，其他 provider 填对应 key）
# 切换 provider 时会自动使用下方对应 key，无需重复填写
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
MIMO_API_KEY=

# 是否启用大模型回复（即使配置了 Key 也可单独关闭）
LLM_ENABLED=false

# 模型名（为空时按 provider 使用默认值）
# anthropic 默认: claude-haiku-4-5
# openai 默认:    gpt-4o-mini
# moonshot 默认:  moonshot-v1-8k
# zhipu 默认:     glm-4-flash
# qwen 默认:      qwen-turbo
# mimo 默认:      MiMo-V2.5（可选: MiMo-V2.5-Pro, MiMo-V2-Pro 等，后缀 [1m] 启用 1M 上下文）
LLM_MODEL=

# 自定义 base URL（仅 provider=custom 时需要填写）
LLM_BASE_URL=

# AI 系统提示词（描述你的业务场景）
SYSTEM_PROMPT=你是一位专业的客服助手，请用简洁、礼貌的中文回复客户问题。

# ── 废话库 ──────────────────────────────────────────────────
# 无规则命中时是否从废话库随机抽取一条回复（fillers.json 中配置废话）
FILLER_ENABLED=false

# ── 回复延迟（随机扰动，模拟人工回复节奏） ─────────────────
REPLY_DELAY_MIN_SECONDS=1.0
REPLY_DELAY_MAX_SECONDS=5.0

# ── 存储 ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./messages.db
LOG_LEVEL=INFO

# ── 邮件配置（可选，不填则不发邮件） ───────────────────────────
# 每日报表：每天凌晨发送昨日汇总（回复数/失败数/线索条数）
DAILY_REPORT_ENABLED=false
# SMTP 配置（每日报表和人工介入告警共用）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ── Mac Watcher 配置 ─────────────────────────────────────────
# 轮询间隔（秒）：检查企业微信未读消息的频率
POLL_INTERVAL_SECONDS=5
# 企业微信 Mac 应用 Bundle ID（通常无需修改）
# 查询方式：osascript -e 'id of app "企业微信"'
WECOM_BUNDLE_ID=com.tencent.WeWorkMac
# 静默发送：发送回复时不抢焦点；失败再回退到激活窗口
SILENT_SEND=false
# 群聊自动回复：默认关闭，避免群里被 @ 时给所有人刷屏
GROUP_CHAT_REPLY=false
# 只回复真实外部微信客户（会话带 "@微信" 标记），默认开启
REQUIRE_WECHAT_TAG=true
# 经营线索定时主动扫描间隔（tick 数），120 tick ≈ 10 分钟。0 则禁用
LEADS_PROACTIVE_INTERVAL=120
# 排除名单：会话名字包含任一关键词将被跳过（逗号分隔）
EXCLUDED_SENDERS=经营线索,客户联系,邮件提醒,企业微信团队,文件传输助手,明珠智企

# ── 工作时间（仅在此时间段内自动回复） ─────────────────────
# 格式：HH:MM 24 小时制，多个时段用逗号分隔。
# 设为空字符串则 24 小时回复。
WORK_HOURS=08:30-12:01,14:00-17:31
# 工作日：0=周一 1=周二 ... 6=周日。设为空字符串则每天。
WORK_DAYS=0,1,2,3,4

# ── LLM 速率限制 & 上下文 ──────────────────────────────────
# 同一客户每分钟最多调用 LLM 次数，超出改走 filler 或跳过
LLM_RATE_LIMIT_PER_MINUTE=6
# 给 LLM 的上下文消息数
CONTEXT_MESSAGE_COUNT=3
# 废话库防重复：同一客户最近 N 次回复不会选中同一句 filler
FILLER_ANTIREPEAT_WINDOW=5
# 自回环防护时长（秒）：我方刚发过的同一文本，在此窗口内若被 AX 读到视为自己的消息
ECHO_PROTECT_SECONDS=120.0
# LLM 全部失败时的保底话术（设为空则静默跳过）
LLM_FALLBACK_REPLY=稍等一下哈，马上回复您～

# ── 第三层兜底：OpenRouter（mimo、moonshot 都失败后再试） ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# ── 学习飞轮：被动捕获真人客户经理的纠正/补答为 QA 候选 ──
LEARN_CAPTURE_ENABLED=true

# ── 企微内置 AI 面板回复（实验性） ─────────────────────────
# 开启后：rules 命中失败时，优先用企微自带 AI 助手面板生成回复
WECOM_AI_ENABLED=false
WECOM_AI_TIMEOUT_SECONDS=30.0

# ── RAG（按客户经理蒸馏的话术库） ──────────────────────────
RAG_ENABLED=false
# 用哪位客户经理的话术风格回复（必须存在 data/rag_index/<rag_manager>/）
RAG_MANAGER=罗响
# top-1 score ≥ 此阈值 → 直接复用历史回复（A 路径）
RAG_DIRECT_THRESHOLD=0.85
# top-1 score ≥ 此阈值 → 走 few-shot 增强 LLM（B 路径）
RAG_FEWSHOT_THRESHOLD=0.55
# few-shot 示例条数
RAG_TOPK=3
