# 环境变量（含密钥，绝对不要提交）
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# 数据库
*.db
*.sqlite3

# 系统文件
.DS_Store
Thumbs.db

# 日志：当前 daemon.log 在仓库里历史遗留，但轮转的 .1~.N 绝不能上 GitHub
*.log
daemon.log.*
logs/

# IDE
.vscode/
.idea/
.workbuddy/

# 运行时产物
.daemon.pid
ax_tree.txt
.claude/
