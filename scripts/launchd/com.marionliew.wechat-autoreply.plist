<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marionliew.wechat-autoreply</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/marionliew/Documents/Claude/wechat-autoreply/.venv/bin/python</string>
        <string>/Users/marionliew/Documents/Claude/wechat-autoreply/run.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/marionliew/Documents/Claude/wechat-autoreply</string>

    <!-- 开机/登录后自动启动 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 进程崩溃 / 退出 → launchd 自动重新启动（除非主动 unload） -->
    <key>KeepAlive</key>
    <true/>

    <!-- 节流：太频繁失败时延迟（避免 fork bomb 式重启） -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- launchd 自己的标准输出/错误（与 Python 内部 RotatingFileHandler 的 daemon.log 分开） -->
    <key>StandardOutPath</key>
    <string>/Users/marionliew/Documents/Claude/wechat-autoreply/daemon.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marionliew/Documents/Claude/wechat-autoreply/daemon.stderr.log</string>

    <!-- 让 Python 看到 UTF-8 文件 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>zh_CN.UTF-8</string>
        <key>PYTHONIOENCODING</key>
        <string>utf-8</string>
    </dict>

    <!-- 普通用户级别即可，无需 root -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
